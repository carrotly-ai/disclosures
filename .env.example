# SEC requires a descriptive User-Agent containing contact information.
# Used for all US SEC EDGAR calls; GLEIF needs no credential.
DISCLOSURES_USER_AGENT="Your Organization your-email@example.com"

# Optional per-jurisdiction API keys. Set only the ones you query; US/GLEIF
# calls work without any of these.

# UK Companies House — required for all jurisdiction: "GB" operations.
# https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=""

# South Korea DART / OpenDART — required for all jurisdiction: "KR" operations.
# https://opendart.fss.or.kr/
OPENDART_API_KEY=""

# Japan EDINET (API v2) — required for jurisdiction: "JP" document search.
# JP CompanyResolve works without it (the EDINET code list is public).
# https://api.edinet-fsa.go.jp/
EDINET_API_KEY=""
